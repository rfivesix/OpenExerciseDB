{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schema/translation.schema.json",
  "title": "Exercise translation",
  "description": "Validiert data/i18n/<lang>/<id>.yaml. Eine Datei je Uebung je Sprache - eine neue Sprache ist ein neues Verzeichnis, kein Schema-Change.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exercise_id",
    "language",
    "status",
    "name",
    "upstream"
  ],
  "properties": {
    "exercise_id": {
      "type": "string"
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[A-Z]{2})?$",
      "description": "Muss in vocab/languages.yaml registriert sein."
    },
    "status": {
      "enum": [
        "human",
        "ai_reviewed",
        "ai_raw"
      ],
      "description": "Auf Dokumentebene, nicht pro Feld - Texte werden als Ganzes uebersetzt und geprueft."
    },
    "translated_from": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "description": {
      "type": "string"
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "common_mistakes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "search_terms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Synonyme und gaengige Falschschreibungen. Geht in den Suchindex, wird nie angezeigt."
    },
    "upstream": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "license"
      ],
      "description": "wger lizenziert PRO UEBERSETZUNG. Siehe SCHEMA.md 3b.",
      "properties": {
        "license": {
          "enum": [
            "CC-BY-SA-4.0",
            "CC-BY-SA-3.0",
            "CC-BY-4.0",
            "CC0-1.0",
            "ODbL-1.0"
          ]
        },
        "license_author": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": "string"
        }
      }
    }
  }
}